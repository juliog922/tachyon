# Every environment variable Tachyon reads, each set to its default or commented out.
#
# Tachyon reads no configuration file: copy this one, keep the lines you change, and load it into your shell, e.g.
#   cp env.example ~/.config/tachyon.env   # edit it
#   echo 'set -a; . ~/.config/tachyon.env; set +a' >> ~/.bashrc
# The daemon reads its settings when it starts: `tachyon down && tachyon up` after a change. A command-line flag
# (`tachyon up --keep-alive=60`) wins over the variable.

# --- Hugging Face (tachyon pull) ---------------------------------------------------------------------------------
# A token (https://huggingface.co/settings/tokens, "read" is enough): gated repositories and higher rate limits.
# Sent to the Hub only, never to the CDN the files come from.
#HF_TOKEN=hf_...
# The Hub, or a mirror of it.
#TACHYON_HUB=https://huggingface.co
# Parallel connections per download.
#TACHYON_CONNECTIONS=8

# --- Where things live -------------------------------------------------------------------------------------------
# Pulled models; else $XDG_DATA_HOME/tachyon, else ~/.local/share/tachyon.
#TACHYON_HOME=~/.local/share/tachyon
# Downloaded checkpoints wait to be converted in $XDG_CACHE_HOME/tachyon (~/.cache/tachyon).
#XDG_CACHE_HOME=~/.cache
# `tachyon up` writes the daemon's log to $XDG_STATE_HOME/tachyon/serve.log (~/.local/state/tachyon).
#XDG_STATE_HOME=~/.local/state

# --- The daemon (tachyon serve / up; flags --keep-alive=, --data-mib=, --vram-mib=, --host-mib=, --socket=) -------
# Seconds a model stays in memory after its last request, unless a request or `tachyon load --keep-alive=` says
# otherwise. Then it is freed (VRAM and RAM) and read from disk at its next request.
TACHYON_KEEP_ALIVE=300
# MiB of VRAM the models may take, towers and encoders included; by default 70% of the GPU's.
#TACHYON_VRAM_MIB=4300
# MiB of pinned RAM for models moved out of VRAM to make room for another (back in VRAM at PCIe speed); by
# default half the machine's RAM. 0: such models go straight to disk.
#TACHYON_HOST_MIB=8192
# MiB of shared memory per client, for attachments (images, audio) and results (embeddings, probabilities).
TACHYON_DATA_MIB=64
# The socket; else $XDG_RUNTIME_DIR/tachyon.sock, else /tmp/tachyon-<uid>.sock.
#TACHYON_SOCKET=/run/user/1000/tachyon.sock

# --- GPU and driver ----------------------------------------------------------------------------------------------
# Tachyon uses GPU 0 of those the driver shows; these pick which (read by the driver itself).
#CUDA_DEVICE_ORDER=PCI_BUS_ID
#CUDA_VISIBLE_DEVICES=0
# The driver library; else libcuda.so.1 (on WSL2, /usr/lib/wsl/lib/libcuda.so.1).
#TACHYON_LIBCUDA=/usr/lib/x86_64-linux-gnu/libcuda.so.1

# --- Development: tests and benches ------------------------------------------------------------------------------
# Hugging Face checkpoints (tokenizer tests and benches): $TACHYON_MODELS/gemma-4-E4B-it/tokenizer.json.
#TACHYON_MODELS=~/models
# Converted models the agreement test and benches run; defaults under ~/.local/share/tachyon.
#TACHYON_MODEL=~/.local/share/tachyon/gemma-4-e4b
#TACHYON_MODEL_SMALL=~/.local/share/tachyon/gemma-4-e2b
#TACHYON_LAYA=~/.local/share/tachyon/laya-multilingual
#TACHYON_GRANITE=~/.local/share/tachyon/granite-embedding-311m
# Bench baselines: the machine's name (else the host name), and 1 to save a run as its baseline.
#TACHYON_BENCH_MACHINE=laptop-3060
#TACHYON_BENCH_SAVE=1
# Where the load bench writes its test file (put it on the disk models load from).
#TACHYON_BENCH_DIR=target/bench
# The download bench: bytes to fetch, and from which repository.
#TACHYON_BENCH_BYTES=268435456
#TACHYON_BENCH_REPO=google/gemma-4-E2B-it
# Draws per distribution in the sampler's χ² test.
#TACHYON_TEST_DRAWS=250000
