{"text": "[{\"role\": \"customer\", \"text\": \"Hi, my card was declined but the money left my account.\"}, {\"role\": \"agent\", \"text\": \"Sorry to hear that. Can you share the last four digits of the card?\"}, {\"role\": \"customer\", \"text\": \"It ends in 4421. The charge was 89.90.\"}, {\"role\": \"agent\", \"text\": \"Thanks, I see a pending authorization that should be released in 3 to 5 days.\"}, {\"role\": \"customer\", \"text\": \"That's not acceptable, I need that money today. I want to cancel everything.\"}]", "ids": [179934, 58, 10656, 8570, 1196, 352, 21132, 630, 352, 875, 1196, 352, 11977, 11, 878, 4684, 631, 47274, 845, 250, 3838, 3499, 878, 3466, 3628, 4108, 10308, 8570, 1196, 352, 16597, 630, 352, 875, 1196, 352, 32697, 276, 9434, 443, 13, 4029, 440, 5053, 250, 2118, 4169, 36614, 288, 250, 4684, 16509, 4108, 10308, 8570, 1196, 352, 21132, 630, 352, 875, 1196, 352, 3146, 16754, 266, 180, 36747, 16, 13, 581, 8221, 631, 180, 7355, 13, 2687, 3628, 4108, 10308, 8570, 1196, 352, 16597, 630, 352, 875, 1196, 352, 14610, 11, 317, 1866, 221, 27262, 41147, 443, 1706, 373, 9746, 266, 180, 18, 276, 180, 20, 3315, 3628, 4108, 10308, 8570, 1196, 352, 21132, 630, 352, 875, 1196, 352, 42799, 583, 33031, 11, 317, 1260, 443, 3838, 3973, 13, 317, 1631, 276, 13248, 5425, 3628, 51771, 179938], "embedding": [-0.0580053, 1.7e-05, 0.0015937, -0.0017708, 0.049284, -0.0027798, -0.022957, -0.0276485, 0.0005914, -0.0245016, 0.0335429, -0.0445799, 0.002357, 0.1073545, 0.0258637, -0.0035773, -0.047175, 0.0113835, 0.0011429, 0.0041129, -0.0038283, 0.0165253, 0.0096596, -0.0226107, -0.0103615, -0.0347901, 0.0222923, 0.0058474, 0.022857, 0.0251453, -0.040643, 0.0282259, -0.0080997, 0.0566469, 0.0349399, 0.0052429, -0.0064974, 0.0622394, -0.0438362, -0.0176365, -0.0191813, -0.0032294, -0.0111063, 0.0319577, -0.020867, -0.0448612, 0.0182553, -0.0215899, -0.0031489, -0.0209353, 0.004766, -0.0138324, -0.0134201, 0.012359, -0.0039415, -0.0215018, 0.0263575, 0.000759, 0.0415284, -0.050