{"text": "[{\"role\": \"customer\", \"text\": \"Hi, my card was declined but the money left my account.\"}, {\"role\": \"agent\", \"text\": \"Sorry to hear that. Can you share the last four digits of the card?\"}, {\"role\": \"customer\", \"text\": \"It ends in 4421. The charge was 89.90.\"}, {\"role\": \"agent\", \"text\": \"Thanks, I see a pending authorization that should be released in 3 to 5 days.\"}, {\"role\": \"customer\", \"text\": \"That's not acceptable, I need that money today. I want to cancel everything.\"}]", "ids": [2, 236840, 14937, 10639, 1083, 623, 25016, 827, 623, 1005, 1083, 623, 10979, 236764, 1041, 3733, 691, 24984, 840, 506, 3273, 2378, 1041, 2881, 221476, 3714, 10639, 1083, 623, 20154, 827, 623, 1005, 1083, 623, 37001, 531, 6899, 600, 236761, 3199, 611, 4024, 506, 1774, 2390, 26798, 529, 506, 3733, 7462, 1263, 3714, 10639, 1083, 623, 25016, 827, 623, 1005, 1083, 623, 1509, 10842, 528, 236743, 236812, 236812, 236778, 236770, 236761, 669, 5536, 691, 236743, 236828, 236819, 236761, 236819, 236771, 221476, 3714, 10639, 1083, 623, 20154, 827, 623, 1005, 1083, 623, 12879, 236764, 564, 1460, 496, 22600, 36605, 600, 1374, 577, 6811, 528, 236743, 236800, 531, 236743, 236810, 2668, 221476, 3714, 10639, 1083, 623, 25016, 827, 623, 1005, 1083, 623, 6372, 236789, 236751, 711, 20626, 236764, 564, 1202, 600, 3273, 3124, 236761, 564, 1461, 531, 13027, 4326, 1781, 15947], "embedding": [-0.0052059, -0.031308, -0.0036185, -0.0024881, 0.0095588, -0.0409294, 0.0532563, 0.0294408, 0.0335984, 0.0032943, 0.0152789, -0.0091923, 0.1949439, -0.0083214, -0.025869, -0.0020107, -0.0337408, 0.0087494, 0.0229666, 0.0217195, -0.0413535, -0.0259409, 0.0184252, 0.0132151, 0.0212571, 0.0077955, 0.0155872, 0.017895, -0.0154583, 0.0092716, -0.0261605, -0.0006199, 0.0219295, 0.0011269, -0.0228114, 0.0156841, -0.0243637, 0.01444, -0.0063635, 0.009294, -0.0021868, 0.0272077, 0.0481499, 0.0196439, -0.0177379, 0.0033355, -0.0375916, 0.0242755, 0.0020073, 0.023693, -0.0143419, -0.0150